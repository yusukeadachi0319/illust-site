---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { blogTitle, blogDescription } from '../../lib/site';

// 最初から見せる記事数（それより古いものは「more」に格納）
const VISIBLE = 3;

// 日付降順。tags に event があれば「イベント告知」、それ以外は「パンダ飼育日記」
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const isEvent = (p: (typeof posts)[number]) => (p.data.tags ?? []).includes('event');
const events = posts.filter(isEvent);
const diary = posts.filter((p) => !isEvent(p));
---

<Base title="blog" description={`イベント告知と${blogTitle}。${blogDescription}`}>
  <section class="section">
    <h1 class="section-title">イベント告知</h1>
    <PostList posts={events} visible={VISIBLE} />
  </section>

  <section class="section">
    <div class="head">
      <h2 class="section-title">{blogTitle}</h2>
      <p class="lead">{blogDescription}</p>
    </div>
    <PostList posts={diary} visible={VISIBLE} />
  </section>
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .lead {
    margin-bottom: 24px;
  }
</style>
